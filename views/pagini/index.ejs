<%- include('../fragmente/head') %>

<%- include('../fragmente/header') %>

  <main>
    <div id="grid-pagina">

      <section id="welcome">
        <hgroup>
          <h2 class="heading-reflexie" data-text="Bine ati venit">Bine ati venit</h2>
          <p class="subtitlu">Partenerul tau in performanta</p>
        </hgroup>

        <div class="text-coloane">
          <p class="intro">Va multumim ca ne vizitati site-ul. Echipa noastra este gata sa va ajute sa va atingeti obiectivele de fitness prin <b>antrenament</b> intens si <b>conditionare</b> fizica superioara. Magazinul CrossFit este dedicat furnizării de echipamente de cea mai înaltă calitate pentru atleții care nu acceptă compromisuri. Indiferent dacă ești la început de drum sau ești un veteran al competițiilor, avem soluțiile potrivite pentru tine. De la haltere olimpice la sisteme complexe de rack-uri, fiecare produs este testat pentru a rezista celor mai dure antrenamente.</p>
        </div>

        <!-- Element Duotone -->
        <div id="container-duotone">
          <h3>Efect Duotone</h3>
          <div id="imagine-duotone"></div>
        </div>

        <blockquote cite="https://ro.wikipedia.org/wiki/CrossFit">
          "The only way to do it is to do it." - Greg Glassman, Founder of CrossFit.
        </blockquote>

        <dl>
          <dt>CrossFit</dt>
          <dd>Un program de fitness care promoveaza atat performanta fizica, cat si sanatatea generala.</dd>
          <dt>WOD</dt>
          <dd>Workout of the Day - antrenamentul specific pentru ziua respectiva.</dd>
        </dl>

        <div class="intro-oferte">
          <div>Greutati</div>
          <div>Benzi</div>
          <div>Corzi</div>
          <div>Manusi</div>
          <div>Pantofi</div>
        </div>
        <p class="anunt intro">Produsele noastre sunt testate de atleti de top care pun pret pe <b>forta</b>. Puteti comanda online sau ne puteti vizita la showroom-ul nostru pentru a vedea noile noastre <b>masinarii</b>.</p>

        <div id="dv-prezentare-1">
          <div id="dv-prezentare">
            <figure>
              <div id="video-container">
                <video width="640" height="360" controls poster="/resurse/imagini/sigla.png" preload="metadata">
                  <source src="/resurse/video/echipament.mp4" type="video/mp4">
                  <source src="/resurse/video/echipament.webm" type="video/webm">
                  <track src="/resurse/vtt/subtitrari_ro.vtt" kind="subtitles" srclang="ro" label="Română" default>
                  <track src="/resurse/vtt/subtitrari_en.vtt" kind="subtitles" srclang="en" label="English">
                  Browser-ul tău nu suportă tag-ul video.
                </video>
              </div>
              <figcaption class="centrat">Echipament de antrenament profesional</figcaption>
            </figure>
          </div>
        </div>
      </section>

      <section id="promotii">
        <h2>Promotii si oferte speciale</h2>

        <article>
          <h3 class="titlu">Super oferta de weekend</h3>
          <p><b>Magazinul CrossFit</b> ofera <b>reduceri de <s>10%</s> <ins>20%</ins></b> pentru toate accesoriile cumparate in intervalul 10-14.</p>
          <p>Oferta este valabila doar in zilele de sambata si duminica la sediile <abbr title="Magazin CrossFit">MC</abbr>.</p>
          <p>In cazul in care cumparati mai mult de trei <b>perechi de incaltaminte</b> primiti si un card de fidelitate!</p>
        </article>

        <article>
          <h3>Pachete de start</h3>
          <p>Pachetele noastre cuprind:</p>
          <ol>
            <li><i lang="en">Jump rope</i></li>
            <li>Un set de 3 benzi elastice</li>
            <li>O sticla de apa reutilizabila</li>
            <li>Un <em>prosop</em> personalizat</li>
            <li>Gratis: un ghid de antrenament <mark>Bonus</mark></li>
          </ol>
          <p>Descarca manualul de utilizare: <a href="/resurse/imagini/sigla.png" download="manual_echipament_2026.png">Download Manual (Imagine)</a></p>
        </article>

        <section>
          <h3>Documentatie oficiala</h3>
          <embed src="/resurse/proiect.pdf" type="application/pdf" width="100%" height="400px" />
        </section>
      </section>

      <section id="produse-noi" class="mb-5 mt-4 pt-4 border-top">
        <h2 class="text-center mb-4 text-primary"><i class="fa-solid fa-fire text-danger"></i> Cele mai noi apariții</h2>
        <% if(locals.produseNoi && produseNoi.length > 0) { %>
          <div class="row row-cols-1 row-cols-md-3 g-4">
            <% produseNoi.forEach(p => { %>
              <div class="col">
                <a href="/produs/<%- p.id %>" class="text-decoration-none text-dark">
                  <div class="card h-100 shadow-sm border-0 position-relative transition">
                    <span class="badge bg-danger position-absolute top-0 start-0 m-2 px-3 py-2 fs-6" style="z-index:2;">NOU</span>
                    <div class="card-img-top-container p-3 d-flex align-items-center justify-content-center bg-light rounded-top" style="height: 220px;">
                      <img src="<%- p.imagine %>" class="img-fluid transition" alt="<%- p.nume %>" style="max-height: 100%; object-fit: contain;">
                    </div>
                    <div class="card-body text-center bg-white rounded-bottom">
                      <h5 class="card-title text-truncate"><%- p.nume %></h5>
                      <span class="badge bg-secondary mb-2"><%- p.categorie %></span>
                      <p class="text-success fw-bold fs-5 mb-0"><%- p.pret %> RON</p>
                    </div>
                  </div>
                </a>
              </div>
            <% }) %>
          </div>
        <% } %>
      </section>

      <section id="produse">
        <h2>Produsele noastre</h2>
        <p>Popularitatea magazinului în acest moment:</p>
        <meter value="0.8" min="0" max="1" low="0.3" high="0.7" optimum="0.9">80%</meter>
        <p>Stoc curent centuri:</p>
        <meter value="10" min="0" max="100" low="25" high="75">10%</meter>

        <section>
          <h3>Echipament Greu</h3>
          <p>Pentru cei care vor sa ridice greutati <cite>heavy</cite>.</p>
          <ul>
            <li>Haltere</li>
            <li>Gantere</li>
            <li>Kettlebells</li>
            <li>Discuri olimpice</li>
          </ul>
        </section>

        <section>
          <h3>Cardio</h3>
          <p>Imbunatateste-ti <dfn title="Capacitatea sistemelor cardiovascular si respirator de a furniza oxigen">conditia fizica</dfn> folosind echipamente de <b>cardio</b> de ultima generatie.</p>
          <ul>
            <li>Rower (Aparat de vaslit)</li>
            <li>BikeErg</li>
            <li>SkiErg</li>
            <li>AirBike</li>
          </ul>
        </section>
      </section>

      <section id="orar">
        <h2>Orar Showroom</h2>
        <div class="tabel-container">
          <table id="tab-orar">
            <caption>Programul de functionare al showroom-ului nostru din Bucuresti</caption>
            <thead>
              <tr>
                <th>Cod</th>
                <th>Perioada</th>
                <th>Zi</th>
                <th>Interval dimineata</th>
                <th>Pauza de masa</th>
                <th>Interval seara</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>L01</td>
                <td rowspan="5">Zile Lucratoare</td>
                <td>Luni</td>
                <td>10:00 - 12:00</td>
                <td>12:00 - 14:00</td>
                <td>14:00 - 20:00</td>
              </tr>
              <tr>
                <td>M02</td>
                <td>Marti</td>
                <td>09:00 - 12:00</td>
                <td>12:00 - 14:00</td>
                <td>14:00 - 21:00</td>
              </tr>
              <tr>
                <td>MI03</td>
                <td>Miercuri</td>
                <td>09:00 - 11:00</td>
                <td>11:00 - 13:00</td>
                <td>14:00 - 21:00</td>
              </tr>
              <tr>
                <td>J04</td>
                <td>Joi</td>
                <td>09:00 - 11:00</td>
                <td>11:00 - 13:00</td>
                <td>14:00 - 21:00</td>
              </tr>
              <tr>
                <td>V05</td>
                <td>Vineri</td>
                <td>09:00 - 12:00</td>
                <td>12:00 - 14:00</td>
                <td>14:00 - 19:00</td>
              </tr>
              <tr>
                <td>S06</td>
                <td rowspan="2">Weekend</td>
                <td>Sambata</td>
                <td>10:00 - 12:00</td>
                <td>12:00 - 13:00</td>
                <td>13:00 - 16:00</td>
              </tr>
              <tr>
                <td>D07</td>
                <td>Duminica</td>
                <td>10:00 - 14:00</td>
                <td> - </td>
                <td>Inchis</td>
              </tr>
            </tbody>
            <tfoot>
              <tr>
                <td colspan="6">Inchis cu ocazia sarbatorilor legale.</td>
              </tr>
            </tfoot>
          </table>
        </div>
        <p><strong>Atentie!!!</strong> In prima zi a fiecarei luni se face inventarul <wbr> si magazinul este inchis.</p>
      </section>

      <aside>
        <h3>Informatii suplimentare</h3>
        <p>Livrarea este gratuita pentru comenzi de peste 300 RON. Oferim garantie 2 ani pentru toate aparatele.</p>
        <p>Vizitati si blogul nostru pentru <q>sfaturi de antrenament</q>.</p>
        <p><a href="https://www.reebok.com" target="_blank">Partenerul nostru oficial Reebok</a></p>
        <p>Mai multe detalii despre parteneriat aici: <a href="https://www.reebok.com/c/crossfit/partnership-details">https://www.reebok.com/<wbr>c/crossfit/<wbr>partnership-details</a></p>
      </aside>

      <section id="anunturi">
        <h2>Anunturi Recente</h2>
        
        <!-- Element Bootstrap: Alert pentru noutăți -->
        <div class="alert alert-info tema-dark" role="alert">
          <h4 class="alert-heading">Noutate: Program de fidelizare!</h4>
          <p>De acum, fiecare achiziție îți aduce puncte bonus care pot fi folosite pentru reduceri viitoare.</p>
          <hr>
          <p class="mb-0">Vizitează secțiunea contului tău pentru a activa cardul virtual.</p>
        </div>

        <ol>
          <li><time datetime="2026-03-01">1 martie 2026</time> - Am lansat noua colectie de <b>incaltaminte</b> Nano X5!</li>
          <li><time datetime="2026-02-15">15 februarie 2026</time> - Workshop de Weightlifting la sediul nostru pentru <b>greutate corporala</b>.</li>
          <li><time datetime="2026-01-01">1 ianuarie 2026</time> - La multi ani! Pregateste-te pentru Open-ul CrossFit.</li>
        </ol>

        <!-- Element Bootstrap: Carduri pentru teme -->
        <div class="row mt-4">
          <div class="col-md-6 mb-3">
            <div class="card tema-crossfit h-100">
              <div class="card-header">Tema CrossFit Orange</div>
              <div class="card-body">
                <h5 class="card-title">Echipament de Performanță</h5>
                <p class="card-text">Această temă folosește culorile noastre brand, optimizate pentru vizibilitate maximă.</p>
                <a href="#" class="btn btn-primary">Vezi detalii</a>
              </div>
            </div>
          </div>
          <div class="col-md-6 mb-3">
            <div class="card tema-dark h-100">
              <div class="card-header">Tema Dark Night</div>
              <div class="card-body">
                <h5 class="card-title">Antrenament de Noapte</h5>
                <p class="card-text">O temă elegantă, ideală pentru cei care preferă un aspect modern și odihnitor pentru ochi.</p>
                <a href="#" class="btn btn-outline-primary">Află mai multe</a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="index-intrebari">
        <h2>Intrebari frecvente</h2>
        <details>
          <summary>Livrati in toata tara?</summary>
          <p>Da, livram prin curier rapid oriunde in Romania in 24-48 ore.</p>
        </details>
        <details>
          <summary>Pot returna produsele?</summary>
          <p>Da, aveti dreptul de retur in 14 zile de la primirea coletului, fara explicatii suplimentare.</p>
        </details>
      </section>

    </div>

    <%- include('../fragmente/galerie') %>

    <section id="retete">
      <h2>Ghiduri Video</h2>
      <p>Invata cum sa folosesti corect echipamentul pentru a evita accidentarile.</p>
      <div class="container-iframe">
        <div class="taburi-iframe">
          <a href="https://www.youtube.com/embed/5FJAhK2V5uQ" target="ifr-video">What is CrossFit?</a>
          <a href="https://www.youtube.com/embed/DqkYuWR4zRI" target="ifr-video">Kettlebell Swing Guide</a>
          <a href="https://www.youtube.com/embed/ZN0J6qKCIrI" target="ifr-video">How to Row</a><br />
        </div>
        <iframe width="560" height="315" src="https://www.youtube.com/embed/jfKfPfyJRdk" name="ifr-video" title="YouTube video player" style="border: none;" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen>
        </iframe>
      </div>
    </section>

  </main>

<%- include('../fragmente/footer') %>