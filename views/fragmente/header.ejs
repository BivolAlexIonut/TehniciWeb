  <header id="header-principal">
    <div id="header-top-bar">
      <h1 id="t">Magazin <span>CrossFit</span></h1>
      <select id="select-tema" aria-label="Schimba Tema">
        <option value="light">☀ Light</option>
        <option value="dark">🌙 Dark</option>
        <option value="crossfit">🌅 Warm</option>
      </select>
    </div>

    <nav>
      <div id="info-utilizator">
        <p>IP-ul tău: <%= ipUtilizator %></p>
      </div>
      <label id="hamburger" for="ch-menu">
        <div id="hamburger-container">
          <span class="bar bar-1"></span>
          <span class="bar bar-2"></span>
          <span class="bar bar-3"></span>
        </div>
      </label>
      <input type="checkbox" id="ch-menu" />
      <ul class="meniu">
        <li>
          <label for="ch-acasa" style="cursor: pointer; width: 100%; display: block;">
            <div class="text-icon" id="acasa">Acasa</div>
            <div class="imag-icon" id="acasa-mediu">
              <span class="fas fa-regular fa-house"></span>
            </div>
          </label>
          <input type="checkbox" id="ch-acasa" class="ch-submeniu" />
          <ul>
            <li><a href="/#welcome">Bine ati venit</a></li>
            <li><a href="/#promotii">Promotii</a></li>
            <li><a href="/#anunturi">Anunturi</a></li>
            <li><a href="/#produse">Produse</a></li>
            <li><a href="/#orar">Orar</a></li>
            <li><a href="/#index-intrebari">Intrebari</a></li>
            <li><a href="/#retete">Ghiduri</a></li>
            <li><a href="/#subsol">Contact</a></li>
          </ul>
        </li>
        <li>
          <div class="text-icon"><a href="#">Inregistrare</a></div>
          <div class="imag-icon"><span class="fas fa-solid fa-user-plus"></span></div>
        </li>
        <li>
          <div><label for="ch-despre" style="cursor: pointer; width: 100%; display: block;">Despre</label></div>
          <input type="checkbox" id="ch-despre" class="ch-submeniu" />
          <ul>
            <li><a href="/despre#prezentare">Prezentare</a></li>
            <li><a href="/despre#istoric">Istoric</a></li>
            <li><a href="/despre#motivatie">Motivatie</a></li>
            <li><a href="/despre#galerie">Galerie</a></li>
          </ul>
        </li>
        <li>
          <div><label for="ch-produse" style="cursor: pointer; width: 100%; display: block;">Produse</label></div>
          <input type="checkbox" id="ch-produse" class="ch-submeniu" />
          <ul>
            <li><a href="/produse">Toate</a></li>
            <% if(locals.optiuniMeniu) { %>
                <% for(let categ of optiuniMeniu) { %>
                    <li><a href="/produse?categorie=<%- encodeURIComponent(categ) %>"><%- categ %></a></li>
                <% } %>
            <% } %>
            <li><a href="/seturi">Seturi (Oferte)</a></li>
          </ul>
        </li>

        <li><a href="#"><i class="fa-regular fa-envelope"></i> Contact</a></li>
      </ul>
    </nav>
  </header>
